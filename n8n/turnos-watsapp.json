    {
      "parameters": {
        "jsCode": "const profesional = $('Supabase - Profesional').first().json;\nconst turnosOcupados = $('Supabase - Turnos').all().map(item => item.json).filter(t => t.start_time);\n\nconst duracion = profesional.duracion_consulta_minutes;\nconst slots = [];\nconst hoy = new Date();\n\nfor (let dia = 0; dia < 7; dia++) {\n  const fecha = new Date(hoy);\n  fecha.setDate(hoy.getDate() + dia);\n  const diaSemana = fecha.getDay();\n\n  if (diaSemana === 0 && !profesional.atiende_domingos) continue;\n  if (diaSemana === 6 && !profesional.atiende_sabados) continue;\n\n  const [horaInicio] = profesional.hora_inicio.split(':').map(Number);\n  const [horaFin] = profesional.hora_fin.split(':').map(Number);\n\n  for (let hora = horaInicio; hora < horaFin; hora += duracion / 60) {\n    const slotStart = new Date(fecha);\n    slotStart.setHours(Math.floor(hora), (hora % 1) * 60, 0, 0);\n    const slotEnd = new Date(slotStart.getTime() + duracion * 60000);\n\n    const ocupado = turnosOcupados.some(t => {\n      const tStart = new Date(t.start_time);\n      const tEnd = new Date(tStart.getTime() + duracion * 60000);\n      return slotStart < tEnd && slotEnd > tStart;\n    });\n\n    if (!ocupado && slotStart > hoy) {\n      slots.push(slotStart.toISOString());\n    }\n  }\n}\n\nconst slotsElegidos = slots.slice(0, 5);\n\n// Texto legible en español para cada slot\nconst formateados = slotsElegidos.map((iso, index) => {\n  const fecha = new Date(iso);\n  const diasSemana = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];\n  const diaNombre = diasSemana[fecha.getDay()];\n  const diaMes = fecha.getDate();\n  const mes = fecha.getMonth() + 1;\n  const hora = fecha.getHours().toString().padStart(2, '0');\n  const min = fecha.getMinutes().toString().padStart(2, '0');\n  return `${index + 1}. ${diaNombre} ${diaMes}/${mes}, ${hora}:${min}`;\n});\n\nconst mensajeTexto = `Estos son los horarios disponibles con la ${profesional.nombre}:\\n\\n${formateados.join('\\n')}\\n\\nRespondé con el número del horario que preferís.`;\n\nreturn [{\n  json: {\n    horarios_disponibles: slotsElegidos,\n    output: mensajeTexto\n  }\n}];"
      },

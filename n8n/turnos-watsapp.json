      "parameters": {
        "jsCode": "const mensajeUsuario = $('Input').first().json.body.mensaje.trim();\nconst contexto = $json.contexto; // viene del nodo Postgres, ya es el array de horarios\n\nconst numeroElegido = parseInt(mensajeUsuario, 10);\n\nif (isNaN(numeroElegido) || numeroElegido < 1 || numeroElegido > contexto.length) {\n  return [{\n    json: {\n      valido: false,\n      output: `No entendí tu respuesta. Por favor, respondé con un número del 1 al ${contexto.length} según los horarios que te ofrecí.`\n    }\n  }];\n}\n\nconst horarioElegido = contexto[numeroElegido - 1];\n\nreturn [{\n  json: {\n    valido: true,\n    horario_elegido: horarioElegido,\n    output: '¡Perfecto! Para confirmar tu turno, decime tu nombre completo.'\n  }\n}];"
      },
